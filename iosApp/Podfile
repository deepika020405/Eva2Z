# iosApp/Podfile
platform :ios, '14.0'

target 'iosApp' do
  use_frameworks!

  # ✅ Firebase (Messaging only — no Analytics/tracking)
  pod 'Firebase/Core'
  pod 'Firebase/Messaging'

  # ✅ PhonePe Payment SDK
  pod 'PhonePePayment'

  # ✅ WebRTC — voice calling
  pod 'GoogleWebRTC'

  # ✅ Socket.IO — WebRTC signaling transport
  pod 'Socket.IO-Client-Swift', '~> 16.1'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      # GoogleWebRTC ships device-only (arm64) — exclude arm64 from simulator builds
      # so the linker picks x86_64 / Rosetta instead of failing.
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end

  # Remove any overriding EXCLUDED_ARCHS from the main target so the Pods xcconfig
  # value (arm64) is inherited cleanly without causing a conflict warning.
  main_project = installer.aggregate_targets.first&.user_project
  main_project&.targets&.each do |target|
    target.build_configurations.each do |config|
      config.build_settings.delete('EXCLUDED_ARCHS[sdk=iphonesimulator*]')
    end
  end
  main_project&.save
end
